filters:
  and:
    - 'file.ext == "md"'
    - 'file.inFolder("seeds")'
    - '/^seed-\d{8}-\d{2}$/.matches(file.basename)'

formulas:
  days_old: 'if(seed_date, (today() - date(seed_date)).days, "")'

properties:
  seed_date:
    displayName: "Seed日付"
  question:
    displayName: "質問"
  category:
    displayName: "カテゴリ"
  question_type:
    displayName: "切り口"
  branch:
    displayName: "ブランチ"
  generated_at:
    displayName: "生成時刻"
  formula.days_old:
    displayName: "経過日数"

views:
  - type: table
    name: "最近のSeed"
    order:
      - file.name
      - seed_date
      - category
      - question_type
      - question
      - formula.days_old
      - branch

  - type: cards
    name: "カード"
    order:
      - file.name
      - category
      - question_type
      - question
      - branch
